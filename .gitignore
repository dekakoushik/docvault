frontend/dist/
mobileapp/dist/
mobileapp/.expo/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database local binary & uploads (preserved via Docker volumes in production)
database/*.sqlite*
!database/.gitkeep
uploads/*
!uploads/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
